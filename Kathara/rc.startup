ip a add 10.0.63.254/18 dev eth0
ip a add 192.168.20.9/30 dev eth1
ip a add 192.168.20.53/30 dev eth2
ip a add 192.168.20.33/30 dev eth3
ip a add 192.168.20.49/30 dev eth4
ip a add 192.168.20.6/30 dev eth5

#deslimitacion
ulimit -n 1024
/etc/init.d/quagga start

#NAT salida a Internet
iptables -t nat -A POSTROUTING -o eth6 -j MASQUERADE

#Servidor web visible desde Internet
iptables -t nat -A PREROUTING -i eth6 -p tcp --dport 80 -j DNAT --to-destination 192.168.10.137:80

ln -sf /shared/hosts /etc/hosts
